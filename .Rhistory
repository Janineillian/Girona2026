library(ggplot2)
library(sf)
library(spatstat)
library(inlabru)
library(INLA)
library(SpatialEpi)
library(dplyr)
library(terra)
library(fmesher)
library(scico)
library(patchwork)
question8<-read.csv("/Users/janineillian/Downloads/SurveyData/csv/gr_question8.csv")
points<-question8[,c(2,3)]
points <- points[which(points$lat > 0),]
head(points)
loc_sf <- points%>%st_as_sf(coords=c("lng","lat"),crs = "+proj=longlat +datum=WGS84")
head(loc_sf)
uk_mask <- geodata::gadm(country='GBR', level=1,path=getwd())
Scottish_border <- uk_mask %>%
tidyterra::filter(NAME_1 %in% "Scotland") %>%
st_as_sf() %>%
st_transform(crs = st_crs(loc_sf))
Scottish_border_mainland <- Scottish_border %>% st_cast("POLYGON") %>%
dplyr::mutate(area = st_area(.)) %>%
arrange(desc(area)) |>
slice(1) %>%
st_transform(crs = 27700)
Scottish_border_mainland = st_transform(Scottish_border_mainland,gsub("units=m",
"units=km",st_crs(Scottish_border_mainland)$proj4string))
loc_sf <- loc_sf %>% st_transform(crs = st_crs(Scottish_border_mainland))
sf_mainland <- loc_sf[Scottish_border_mainland,]
mesh_1 = fm_mesh_2d(boundary = Scottish_border_mainland,
max.edge = c(2, 40),
#                   offset = c(5,50),
cutoff = 15,
crs= crs(Scottish_border_mainland))
ggplot() + geom_sf(data=Scottish_border_mainland)  +gg(mesh_1)
mesh_1 = fm_mesh_2d(boundary = Scottish_border_mainland,
max.edge = c(2, 40),
#                   offset = c(5,50),
cutoff = 10,
crs= crs(Scottish_border_mainland))
ggplot() + geom_sf(data=Scottish_border_mainland)  +gg(mesh_1)
spde <- inla.spde2.pcmatern(mesh_1,
prior.range = c(150, .5),  #  Pr(practic.range<150 km)=0.5
prior.sigma = c(1, 0.5))   #  PR(sigma>1)=0.5
cmp <- geometry~Intercept(1) + field(geometry, model = spde)
# fitting the model
fit <- lgcp(
cmp,
samplers = Scottish_border_mainland,
data = sf_mainland,
domain = list(geometry = mesh_1)
)
pxl = fm_pixels(mesh_1, mask= Scottish_border_mainland, dims = c(200,200))
preds = predict(fit, pxl, ~data.frame(spde = field,
log_int = Intercept + field))
ggplot(data= preds$spde) +
geom_sf(aes(color = mean)) +
scale_color_scico() +
ggtitle("spde mean") +
ggplot(data=preds$spde ) +
geom_sf(aes(color = sd)) +
scale_color_scico() +
ggtitle("spde sd") +
ggplot(data=preds$log_int) +
geom_sf(aes(color = mean)) +
scale_color_scico() +
ggtitle("log-int mean")
formula = geometry ~ Intercept + field
lik = bru_obs("cp",
formula = formula,
data = st_mainland,
domain = list(geometry = mesh_1),
samplers = Scottish_border_mainland,
)
lik = bru_obs("cp",
formula = formula,
data = sf_mainland,
domain = list(geometry = mesh_1),
samplers = Scottish_border_mainland,
)
fit2 = bru(cmp, lik)
preds2 = predict(fit2, pxl, ~data.frame(spde = field,
log_int = Intercept + field))
ggplot(data= preds2$spde) +
geom_sf(aes(color = mean)) +
scale_color_scico() +
ggtitle("spde mean") +
ggplot(data=preds2$spde ) +
geom_sf(aes(color = sd)) +
scale_color_scico() +
ggtitle("spde sd") +
ggplot(data=preds2$log_int) +
geom_sf(aes(color = mean)) +
scale_color_scico() +
ggtitle("log-int mean")
