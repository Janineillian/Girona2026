domain <- fmesher::fm_nonconvex_hull(as.matrix(st_coordinates(question8_sf)),crs=fm_crs(question8_sf),
concave = 0.15,convex = 0.15, resolution=c(100,100))
mesh8 <- fmesher::fm_mesh_2d_inla(boundary = domain, crs= inlabru::fm_crs(question8_sf),
max.edge = c(1,3)*max.edge,
offset=c(max.edge, 1.5),
cutoff = max.edge/5)
spde_model =  inla.spde2.pcmatern(mesh8,
prior.sigma = c(1, 0.5),
prior.range = c(100, 0.5))
cmp = ~ Intercept(1) + space(geometry, model = spde_model)
formula = geometry ~ Intercept + space
